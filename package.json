{
  "name": "teamleader-focus-js-sdk",
  "version": "0.7.0",
  "description": "TypeScript SDK for the Teamleader Focus API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "generate": "node --loader ts-node/esm scripts/generate-types.ts",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "oauth": "node --loader ts-node/esm scripts/oauth-token.ts",
    "check-spec": "node --loader ts-node/esm scripts/check-spec-update.ts",
    "diff-spec": "node --loader ts-node/esm scripts/diff-spec.ts",
    "test:coverage": "node --loader ts-node/esm scripts/check-test-coverage.ts",
    "verify:endpoints": "node --loader ts-node/esm scripts/verify-endpoints.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henkdeblauw/teamleader-focus-js-sdk.git"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
